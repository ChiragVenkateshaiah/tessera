# NVIDIA NIM API (LLM client). Get a free key at
# https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b ("Generate API Key")
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Local paths (defaults shown below match the repo layout; override if needed)
TESSERA_CORPUS_DIR=data/corpus
TESSERA_VECTORSTORE_DIR=data/vectorstore
