# NVIDIA NIM API (LLM client). Get a free key at
# https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b ("Generate API Key")
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Which provider answers questions: nvidia (default), gemini or bedrock.
# The eval judge stays on NVIDIA NIM either way, so NVIDIA_API_KEY is
# still needed.
TESSERA_LLM_PROVIDER=nvidia

# Which pipeline answers: native (default) or lc, the Phase 5 LangChain
# stack (needs `uv sync --extra lc`; not built yet). --stack overrides it.
TESSERA_STACK=native

# Gemini on Google Cloud's Agent Platform, formerly Vertex AI (used when
# TESSERA_LLM_PROVIDER=gemini). Credentials are Application Default
# Credentials (`gcloud auth application-default login`), never from here.
# The project id, not its display name.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_ROUTER_MODEL=gemini-3.8-flash
GEMINI_ROUTER_THINKING=low
GEMINI_ANSWER_MODEL=gemini-3.1-pro-preview
GEMINI_ANSWER_THINKING=low

# Claude on Amazon Bedrock (used when TESSERA_LLM_PROVIDER=bedrock). Dormant:
# the AWS account can't pay for Marketplace models (ADR 0007).
# Credentials come from the named AWS profile (~/.aws), never from here;
# the profile needs bedrock-mantle:CreateInference.
BEDROCK_REGION=us-east-1
BEDROCK_AWS_PROFILE=tessera
BEDROCK_ROUTER_MODEL=anthropic.claude-haiku-4-5
# anthropic.claude-opus-4-8 is a drop-in if Opus 5.5 isn't enabled on the account.
BEDROCK_ANSWER_MODEL=anthropic.claude-opus-5-5
BEDROCK_ANSWER_EFFORT=medium

# The LangChain stack's per-layer switches (Phase 5 plan §3.2.1), each
# native or lc; the defaults are the evidence-chosen "lc-defaults" profile.
# Ingestion layers (P5-4, `tessera ingest --stack lc`; evidence in
# evals/reports/p5-4-ingestion.md). TESSERA_LC_INDEXING=lc (LangChain's
# index() + a SQLRecordManager) needs TESSERA_LC_STORE=lc. Changing the
# indexing switch on an existing lc index needs a fresh collection.
TESSERA_LC_LOADER=lc
TESSERA_LC_SPLITTER=native
TESSERA_LC_CHUNK_SIZE=1600
TESSERA_LC_EMBED_PREFIX=true
TESSERA_LC_EMBEDDINGS=lc
TESSERA_LC_STORE=lc
TESSERA_LC_INDEXING=lc
# Retrieval (P5-5): native, lc (vector, = native), parent_doc, bm25, hybrid,
# multiquery (calls the routing model) or rerank (local cross-encoder).
# Evidence: evals/reports/p5-5-retrieval.md.
TESSERA_LC_RETRIEVER=lc
TESSERA_LC_HYBRID_BM25_WEIGHT=0.25
# Generation (P5-6): router (LangChain structured output), prompt_chain
# (the LCEL grounded-answer chain), model_client (ChatNVIDIA /
# ChatGoogleGenerativeAI per TESSERA_LLM_PROVIDER), retry (.with_retry() +
# InMemoryRateLimiter; needs model_client=lc), expertise (PeopleRetriever).
# Evidence: evals/reports/p5-6-generation.md.
TESSERA_LC_ROUTER=native
TESSERA_LC_PROMPT_CHAIN=native
TESSERA_LC_MODEL_CLIENT=native
TESSERA_LC_RETRY=native
TESSERA_LC_EXPERTISE=native

# LangSmith tracing (Phase 5; needs `uv sync --extra lc`). Off by default.
# Enabled ONLY by TESSERA_LANGSMITH_TRACING: every run goes through
# Tessera's redacting client. Never set LANGSMITH_TRACING,
# LANGCHAIN_TRACING_V2 (or the other variables observability/guard.py
# lists) — Tessera refuses to start while they are set, because the
# SDK's own client would trace without redaction.
TESSERA_LANGSMITH_TRACING=false
TESSERA_LANGSMITH_API_KEY=
TESSERA_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
TESSERA_LANGSMITH_PROJECT=tessera

# Local paths (defaults shown below match the repo layout; override if needed)
TESSERA_CORPUS_DIR=data/corpus
TESSERA_VECTORSTORE_DIR=data/vectorstore
TESSERA_EXPERTISE_DIR=data/expertise/people

# Request traces and feedback (runtime data, gitignored)
TESSERA_TRACE_LOG=data/traces/traces.jsonl
TESSERA_FEEDBACK_FILE=data/feedback/feedback.jsonl
TESSERA_FEEDBACK_CANDIDATES=data/feedback/candidates.yaml
# Ethical walls (Phase 4): engagement -> cleared person_ids. Synthetic.
TESSERA_ACCESS_FILE=data/access/walls.yaml
