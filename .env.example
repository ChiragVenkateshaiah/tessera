# NVIDIA NIM API (LLM client). Get a free key at
# https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b ("Generate API Key")
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Which provider answers questions: nvidia (default), gemini or bedrock.
# The eval judge stays on NVIDIA NIM either way, so NVIDIA_API_KEY is
# still needed.
TESSERA_LLM_PROVIDER=nvidia

# Gemini on Google Cloud's Agent Platform, formerly Vertex AI (used when
# TESSERA_LLM_PROVIDER=gemini). Credentials are Application Default
# Credentials (`gcloud auth application-default login`), never from here.
# The project id, not its display name.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_ROUTER_MODEL=gemini-3.6-flash
GEMINI_ROUTER_THINKING=minimal
GEMINI_ANSWER_MODEL=gemini-3.1-pro
GEMINI_ANSWER_THINKING=low

# Claude on Amazon Bedrock (used when TESSERA_LLM_PROVIDER=bedrock). Dormant:
# the AWS account can't pay for Marketplace models (ADR 0007).
# Credentials come from the named AWS profile (~/.aws), never from here;
# the profile needs bedrock-mantle:CreateInference.
BEDROCK_REGION=us-east-1
BEDROCK_AWS_PROFILE=tessera
BEDROCK_ROUTER_MODEL=anthropic.claude-haiku-4-5
# anthropic.claude-opus-4-8 is a drop-in if Opus 5.5 isn't enabled on the account.
BEDROCK_ANSWER_MODEL=anthropic.claude-opus-5-5
BEDROCK_ANSWER_EFFORT=medium

# Local paths (defaults shown below match the repo layout; override if needed)
TESSERA_CORPUS_DIR=data/corpus
TESSERA_VECTORSTORE_DIR=data/vectorstore
TESSERA_EXPERTISE_DIR=data/expertise/people

# Request traces and feedback (runtime data, gitignored)
TESSERA_TRACE_LOG=data/traces/traces.jsonl
TESSERA_FEEDBACK_FILE=data/feedback/feedback.jsonl
TESSERA_FEEDBACK_CANDIDATES=data/feedback/candidates.yaml
# Ethical walls (Phase 4): engagement -> cleared person_ids. Synthetic.
TESSERA_ACCESS_FILE=data/access/walls.yaml
